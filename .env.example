# Existing .env values are preserved. Never expose these through NEXT_PUBLIC_*.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
APP_URL=http://localhost:3000

# Console redirect URLs: {APP_URL}/api/auth/oauth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Kakao REST API key; secret is required when enabled in the Kakao console.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# DB_LOGGING_ENABLED is managed in admin_setting (default false), not in .env.

# Server-side AI credentials. Optional model list/default override discovery.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_MODELS=gpt-5.6-sol,gpt-4o-mini
# Optional image-generation model allowlist/default. Availability is checked against the API.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_MODELS=gpt-image-2.5-sunburst,gpt-image-2.5-flare

# Dedicated 32-byte Base64 AES key. Generate with: node scripts/setup-ai-image-key.mjs
# Preserve this value across deployments to decrypt saved images.
AI_IMAGE_ENCRYPTION_KEY=

# cloudflare hyh8414@gmail.com / D4397!
CLOUDFLARE_ACCOUNT_ID=hyh8414@gmail.com
R2_TOKEN=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=hams-matrix
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# ONLYOFFICE docker server
# 실행 테스트 명령어 : docker run -i -t -d -p 8080:80 --restart=always --name onlyoffice-docs -e JWT_SECRET=my_custom_secret_key_1234 onlyoffice/documentserver
# 로컬 AllFonts.ts 다운로드 명령어: gcloud run services update onlyoffice-docs --region asia-northeast3 --update-env-vars GENERATE_FONTS=true,JWT_SECRET=my_custom_secret_key_1234
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8080
# Docker Desktop의 문서 서버가 Windows에서 실행 중인 앱에 접근하는 주소
ONLYOFFICE_PUBLIC_APP_URL=http://host.docker.internal:3000
ONLYOFFICE_JWT_SECRET=my_custom_secret_key_1234
